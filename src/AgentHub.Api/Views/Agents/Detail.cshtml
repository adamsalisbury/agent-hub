@model AgentDetailViewModel
@{
    ViewData["Title"] = Model.Agent.Name;
}

<div class="row mb-3">
    <div class="col">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active">@Model.Agent.Name</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="d-flex gap-3 align-items-start">
                        <div style="width:100px;height:100px;flex-shrink:0;" class="d-flex align-items-center justify-content-center">
                            @if (!string.IsNullOrEmpty(Model.Agent.AvatarSvg))
                            {
                                <div style="width:100px;height:100px;overflow:hidden;">@Html.Raw(Model.Agent.AvatarSvg)</div>
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 100 100">
                                    <circle cx="50" cy="50" r="50" fill="#e9ecef"/>
                                    <text x="50" y="65" text-anchor="middle" font-size="40" fill="#6c757d" font-family="sans-serif">@Model.Agent.Name.Substring(0, 1).ToUpperInvariant()</text>
                                </svg>
                            }
                        </div>
                        <div>
                        <h4 class="mb-1">
                            <i class="bi bi-cpu me-2"></i>@Model.Agent.Name
                            @if (Model.Agent.IsSystemAgent)
                            {
                                <span class="badge bg-warning text-dark ms-2"><i class="bi bi-shield me-1"></i>System</span>
                            }
                        </h4>
                        @if (!string.IsNullOrEmpty(Model.Agent.JobTitle))
                        {
                            <p class="text-primary fw-semibold mb-1">@Model.Agent.JobTitle</p>
                        }
                        <p class="text-muted mb-2">@Model.Agent.Description</p>
                        <div class="d-flex gap-2 flex-wrap">
                            @if (Model.Agent.Status == AgentStatus.Online)
                            {
                                <span class="badge bg-success"><i class="bi bi-circle-fill me-1"></i>Online</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary"><i class="bi bi-circle me-1"></i>Offline</span>
                            }
                            @if (Model.UnreadCount > 0)
                            {
                                <span class="badge bg-danger"><i class="bi bi-envelope me-1"></i>@Model.UnreadCount unread</span>
                            }
                        </div>
                        <div class="mt-2">
                            @if (!string.IsNullOrEmpty(Model.Agent.CurrentTask))
                            {
                                <div class="alert alert-info py-2 px-3 mb-0 d-inline-flex align-items-center gap-2">
                                    <i class="bi bi-activity"></i>
                                    <span><strong>Currently:</strong> @Model.Agent.CurrentTask</span>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted small"><i class="bi bi-moon me-1"></i>Idle</span>
                            }
                        </div>
                        </div>
                    </div>
                    <div class="text-muted small text-end">
                        <div>ID: <code class="small">@Model.Agent.Id</code></div>
                        <div>Last check-in: @(Model.Agent.LastCheckedInAt.HasValue
                                ? Model.Agent.LastCheckedInAt.Value.ToLocalTime().ToString("g")
                                : "Never")</div>
                    </div>
                </div>
                <div class="mt-3 d-flex gap-2">
                    <a asp-controller="Messages" asp-action="Send" asp-route-fromAgentId="@Model.AllAgents.FirstOrDefault(a => a.IsSystemAgent)?.Id"
                       class="btn btn-sm btn-primary">
                        <i class="bi bi-send me-1"></i>Send Message to @Model.Agent.Name
                    </a>
                    @if (!Model.Agent.IsSystemAgent)
                    {
                        <form asp-controller="Agents" asp-action="Delete" asp-route-id="@Model.Agent.Id" method="post"
                              onsubmit="return confirm('Delete agent @Model.Agent.Name?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash me-1"></i>Delete Agent
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Inbox Tab -->
<div class="row">
    <div class="col">
        <ul class="nav nav-tabs mb-3" id="mailboxTabs">
            <li class="nav-item">
                <a class="nav-link active" data-bs-toggle="tab" href="#conversation">
                    <i class="bi bi-chat-dots me-1"></i>Conversation
                    <span class="badge bg-secondary ms-1">@Model.Conversation.Count</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-bs-toggle="tab" href="#inbox">
                    <i class="bi bi-inbox me-1"></i>Inbox
                    @if (Model.UnreadCount > 0)
                    {
                        <span class="badge bg-danger ms-1">@Model.UnreadCount</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary ms-1">@Model.Inbox.Count</span>
                    }
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-bs-toggle="tab" href="#outbox">
                    <i class="bi bi-send me-1"></i>Outbox
                    <span class="badge bg-secondary ms-1">@Model.Outbox.Count</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-bs-toggle="tab" href="#activity-history">
                    <i class="bi bi-clock-history me-1"></i>Activity History
                    <span class="badge bg-secondary ms-1">@Model.Activities.Count</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-bs-toggle="tab" href="#skills">
                    <i class="bi bi-stars me-1"></i>Skills
                    <span class="badge bg-primary ms-1">@Model.Skills.Count</span>
                </a>
            </li>
        </ul>

        <div class="tab-content">
            <div class="tab-pane fade show active" id="conversation">
                @if (!Model.Conversation.Any())
                {
                    <div class="p-4 text-center text-muted">
                        <i class="bi bi-chat-dots fs-1 d-block mb-2"></i>
                        No messages yet.
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-2 p-3">
                        @foreach (var msg in Model.Conversation)
                        {
                            <div class="d-flex @(msg.IsOutgoing ? "justify-content-end" : "justify-content-start")">
                                <div class="card" style="max-width:70%;">
                                    <div class="card-body py-2 px-3 @(msg.IsOutgoing ? "bg-primary text-white" : "bg-light")">
                                        <div class="d-flex justify-content-between align-items-center gap-3 mb-1">
                                            <small class="fw-semibold">
                                                @if (msg.IsOutgoing)
                                                {
                                                    <span>To: @(msg.RecipientName ?? (msg.IsBroadcast ? "All" : "Unknown"))</span>
                                                }
                                                else
                                                {
                                                    <span>From: @msg.SenderName</span>
                                                }
                                            </small>
                                            <small class="@(msg.IsOutgoing ? "text-white-50" : "text-muted")">@msg.SentAt.ToLocalTime().ToString("g")</small>
                                        </div>
                                        <div class="fw-semibold small">@msg.Subject</div>
                                        @if (msg.AttachmentCount > 0)
                                        {
                                            <div class="mt-1">
                                                <small class="@(msg.IsOutgoing ? "text-white-50" : "text-muted")">
                                                    <i class="bi bi-paperclip me-1"></i>@msg.AttachmentCount attachment(s)
                                                </small>
                                            </div>
                                        }
                                    </div>
                                    <div class="card-footer py-1 px-3 d-flex gap-2">
                                        <a asp-controller="Messages" asp-action="View" asp-route-id="@msg.Id"
                                           class="btn btn-sm btn-outline-secondary py-0">
                                            <i class="bi bi-eye me-1"></i>View
                                        </a>
                                        @if (!msg.IsOutgoing && !msg.IsRead)
                                        {
                                            <span class="badge bg-warning text-dark align-self-center">Unread</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="tab-pane fade" id="inbox">
                <div class="card">
                    <div class="card-body p-0">
                        @if (!Model.Inbox.Any())
                        {
                            <div class="p-4 text-center text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                No messages in inbox.
                            </div>
                        }
                        else
                        {
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th></th>
                                        <th>From</th>
                                        <th>Subject</th>
                                        <th>Received</th>
                                        <th>Attachments</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var msg in Model.Inbox.OrderByDescending(m => m.SentAt))
                                    {
                                        <tr class="@(!msg.IsRead ? "unread-row" : "")">
                                            <td class="text-center" style="width:40px;">
                                                @if (!msg.IsRead)
                                                {
                                                    <i class="bi bi-envelope-fill text-primary" title="Unread"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-envelope-open text-muted" title="Read"></i>
                                                }
                                            </td>
                                            <td>
                                                @if (msg.IsBroadcast)
                                                {
                                                    <span class="badge bg-info text-dark me-1"><i class="bi bi-broadcast me-1"></i>Broadcast</span>
                                                }
                                                @msg.SenderName
                                            </td>
                                            <td>@msg.Subject</td>
                                            <td class="text-muted small">@msg.SentAt.ToLocalTime().ToString("g")</td>
                                            <td>
                                                @if (msg.AttachmentCount > 0)
                                                {
                                                    <span class="badge bg-light text-dark">
                                                        <i class="bi bi-paperclip me-1"></i>@msg.AttachmentCount
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <a asp-controller="Messages" asp-action="View" asp-route-id="@msg.Id"
                                                   class="btn btn-sm btn-outline-secondary">
                                                    <i class="bi bi-eye me-1"></i>View
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="outbox">
                <div class="card">
                    <div class="card-body p-0">
                        @if (!Model.Outbox.Any())
                        {
                            <div class="p-4 text-center text-muted">
                                <i class="bi bi-send fs-1 d-block mb-2"></i>
                                No sent messages.
                            </div>
                        }
                        else
                        {
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>To</th>
                                        <th>Subject</th>
                                        <th>Sent</th>
                                        <th>Status</th>
                                        <th>Attachments</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var msg in Model.Outbox.OrderByDescending(m => m.SentAt))
                                    {
                                        <tr>
                                            <td>
                                                @if (msg.IsBroadcast)
                                                {
                                                    <span class="badge bg-info text-dark"><i class="bi bi-broadcast me-1"></i>Broadcast</span>
                                                }
                                                else
                                                {
                                                    @(msg.RecipientName ?? "Unknown")
                                                }
                                            </td>
                                            <td>@msg.Subject</td>
                                            <td class="text-muted small">@msg.SentAt.ToLocalTime().ToString("g")</td>
                                            <td>
                                                @if (msg.IsRead)
                                                {
                                                    <span class="badge bg-success">Read</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">Unread</span>
                                                }
                                            </td>
                                            <td>
                                                @if (msg.AttachmentCount > 0)
                                                {
                                                    <span class="badge bg-light text-dark">
                                                        <i class="bi bi-paperclip me-1"></i>@msg.AttachmentCount
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <a asp-controller="Messages" asp-action="View" asp-route-id="@msg.Id"
                                                   class="btn btn-sm btn-outline-secondary">
                                                    <i class="bi bi-eye me-1"></i>View
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="activity-history">
                <div class="card">
                    <div class="card-body p-0">
                        @if (!Model.Activities.Any())
                        {
                            <div class="p-4 text-center text-muted">
                                <i class="bi bi-clock-history fs-1 d-block mb-2"></i>
                                No activity recorded yet.
                            </div>
                        }
                        else
                        {
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Description</th>
                                        <th>Started</th>
                                        <th>Completed</th>
                                        <th>Duration</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var activity in Model.Activities)
                                    {
                                        <tr>
                                            <td>@activity.Description</td>
                                            <td class="text-muted small">@activity.StartedAt.ToLocalTime().ToString("g")</td>
                                            <td class="text-muted small">
                                                @if (activity.CompletedAt.HasValue)
                                                {
                                                    @activity.CompletedAt.Value.ToLocalTime().ToString("g")
                                                }
                                                else
                                                {
                                                    <span class="text-info">In Progress</span>
                                                }
                                            </td>
                                            <td class="text-muted small">@activity.FormattedDuration</td>
                                            <td>
                                                @if (activity.IsActive)
                                                {
                                                    <span class="badge bg-info text-dark"><i class="bi bi-activity me-1"></i>Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success"><i class="bi bi-check-lg me-1"></i>Done</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="skills">
                @if (!Model.Skills.Any())
                {
                    <div class="p-4 text-center text-muted">
                        <i class="bi bi-stars fs-1 d-block mb-2"></i>
                        No skills defined yet.
                    </div>
                }
                else
                {
                    <div class="row row-cols-1 row-cols-md-2 g-3 p-3">
                        @foreach (var skill in Model.Skills)
                        {
                            <div class="col">
                                <div class="card h-100">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <h6 class="card-title mb-1">
                                                <i class="bi bi-lightning-charge me-1 text-warning"></i>@skill.Name
                                            </h6>
                                            <form asp-controller="Agents" asp-action="SendConfigRemoveSkill" asp-route-id="@Model.Agent.Id" method="post"
                                                  onsubmit="return confirm('Remove skill @skill.Name?')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="skillName" value="@skill.Name" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </form>
                                        </div>
                                        <p class="card-text text-muted small mb-0">@skill.Description</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- Add Skill Form -->
                <div class="card mx-3 mb-3 mt-2">
                    <div class="card-header">
                        <h6 class="mb-0"><i class="bi bi-plus-lg me-2"></i>Add Skill</h6>
                    </div>
                    <div class="card-body">
                        <form asp-controller="Agents" asp-action="SendConfigAddSkill" asp-route-id="@Model.Agent.Id" method="post">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label for="skillName" class="form-label">Skill Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="skillName" name="skillName"
                                       placeholder="e.g. code-review" required />
                            </div>
                            <div class="mb-3">
                                <label for="skillMarkdown" class="form-label">Skill Markdown <span class="text-danger">*</span></label>
                                <textarea class="form-control font-monospace" id="skillMarkdown" name="skillMarkdown" rows="6"
                                          placeholder="# Skill Name&#10;&#10;Describe what this skill enables the agent to do..." required></textarea>
                                <div class="form-text">Markdown content describing the skill instructions.</div>
                            </div>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-send me-1"></i>Send Add-Skill Config Message
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
