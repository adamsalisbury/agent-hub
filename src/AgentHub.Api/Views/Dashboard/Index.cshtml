@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row mb-4">
    <div class="col">
        <h2><i class="bi bi-grid me-2"></i>Dashboard</h2>
        <p class="text-muted">Agent Hub system overview</p>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-white bg-success mb-3">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="card-title mb-0">Online</h5>
                    <h2 class="mb-0">@Model.OnlineCount</h2>
                </div>
                <i class="bi bi-circle-fill fs-1 opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-secondary mb-3">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="card-title mb-0">Offline</h5>
                    <h2 class="mb-0">@Model.OfflineCount</h2>
                </div>
                <i class="bi bi-circle fs-1 opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-primary mb-3">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="card-title mb-0">Total Agents</h5>
                    <h2 class="mb-0">@Model.Agents.Count</h2>
                </div>
                <i class="bi bi-cpu fs-1 opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card mb-3">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="card-title mb-0">Quick Actions</h5>
                    <a asp-controller="Messages" asp-action="Send" class="btn btn-sm btn-outline-primary mt-2">
                        <i class="bi bi-send me-1"></i>Send Message
                    </a>
                </div>
                <i class="bi bi-lightning fs-1 text-warning opacity-50"></i>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-people me-2"></i>Registered Agents</h5>
                <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#registerAgentModal">
                    <i class="bi bi-plus-lg me-1"></i>Register Agent
                </button>
            </div>
            <div class="card-body p-0">
                @if (!Model.Agents.Any())
                {
                    <div class="p-4 text-center text-muted">
                        <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                        No agents registered yet.
                    </div>
                }
                else
                {
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Status</th>
                                <th>Name</th>
                                <th>Description</th>
                                <th>Last Check-In</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var agent in Model.Agents)
                            {
                                <tr>
                                    <td>
                                        @if (agent.Status == AgentStatus.Online)
                                        {
                                            <span class="badge bg-success"><i class="bi bi-circle-fill me-1"></i>Online</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary"><i class="bi bi-circle me-1"></i>Offline</span>
                                        }
                                        @if (agent.IsSystemAgent)
                                        {
                                            <span class="badge bg-warning text-dark ms-1"><i class="bi bi-shield me-1"></i>System</span>
                                        }
                                    </td>
                                    <td><strong>@agent.Name</strong></td>
                                    <td class="text-muted">@agent.Description</td>
                                    <td class="text-muted small">
                                        @(agent.LastCheckedInAt.HasValue
                                            ? agent.LastCheckedInAt.Value.ToLocalTime().ToString("g")
                                            : "Never")
                                    </td>
                                    <td>
                                        <a asp-controller="Agents" asp-action="Detail" asp-route-id="@agent.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-eye me-1"></i>View
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

<!-- Register Agent Modal -->
<div class="modal fade" id="registerAgentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Agents" asp-action="Register" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-plus-lg me-2"></i>Register New Agent</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="agentName" class="form-label">Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="agentName" name="name"
                               placeholder="e.g. code-review-agent" required />
                        <div class="form-text">Descriptive name for the agent.</div>
                    </div>
                    <div class="mb-3">
                        <label for="agentDescription" class="form-label">Description</label>
                        <textarea class="form-control" id="agentDescription" name="description" rows="3"
                                  placeholder="What does this agent do?"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Register</button>
                </div>
            </form>
        </div>
    </div>
</div>
